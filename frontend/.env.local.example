# MediCall AI — Frontend Environment Variables
# Copy to .env.local and fill in your values

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# App
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_DEBUG=true

# Feature flags
NEXT_PUBLIC_ENABLE_HINDI=true
NEXT_PUBLIC_ENABLE_TAMIL=true
NEXT_PUBLIC_ENABLE_TELUGU=true
NEXT_PUBLIC_ENABLE_BENGALI=true
NEXT_PUBLIC_ENABLE_ENGLISH=true