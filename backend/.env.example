# MediCall AI — Backend Environment Variables
# Copy to .env and fill in your values

# Database (Local PostgreSQL + pgvector)
# Enforcement flip (spec-auth-enforcement.md): the API connects as the NON-owner
# medicall_app role so RLS applies to every statement (postgres_schema.sql
# creates the role + FORCEs RLS; DDL/init stays owner-side). Dev creds only.
DATABASE_URL=postgresql://medicall_app:medicall_app@localhost:5432/medicall

# Voice webhook shared secret (spec-auth-enforcement.md Q2/A2a): provider
# callbacks must send X-Service-Token == this value or they 401. Dev default;
# override in prod. Smoke test reads it as WEBHOOK_SERVICE_TOKEN too.
WEBHOOK_SERVICE_TOKEN=dev-service-token

# Demo tenant bootstrap (schema.sql seed — RLS makes it the ONLY first owner):
#   phone +919876543210 / password DemoPass!2026  (role owner, owns City Care Demo)
# Login via /api/auth/login; smoke_api.py drives the whole domain surface with it.

# Cache (future stub, G6-Q10 Q1=A1): app/db/redis.py reads these but has ZERO
# callers (redis was dropped from the compose stack). Kept with the redis pip
# pin as the starting point for a real cache layer.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telephony (Multi-provider for India)
# Exotel
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_SID=your-exotel-sid
EXOTEL_TOKEN=your-exotel-token

# Knowlarity (SR API — auth headers: `authorization` + `x-api-key`)
KNOWLARITY_API_KEY=your-knowlarity-api-key
KNOWLARITY_AUTHORIZATION=your-knowlarity-authorization-key
KNOWLARITY_SIP_URI=your-knowlarity-sip-uri

# Twilio India
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-india-number

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Deepgram (Multi-language STT)
DEEPGRAM_API_KEY=your-deepgram-api-key
# STT confidence floor (G6-Q4 Q1=A1): below this value a turn's *operative*
# language falls back to English (resolve_stt_language). Empty = 0.6 default.
STT_CONFIDENCE_THRESHOLD=0.6

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs (Multi-language TTS) — canonical per-language keys (G6-Q4 Q4=A1):
# ELEVENLABS_VOICE_ID_{HI,EN,TA,TE,BN}; generic ELEVENLABS_VOICE_ID is the
# fallback for any language without a per-language key.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_HI=your-hindi-voice-id
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_TA=your-tamil-voice-id
ELEVENLABS_VOICE_ID_TE=your-telugu-voice-id
ELEVENLABS_VOICE_ID_BN=your-bengali-voice-id

# Call defaults (G4 — D3)
# Default caller language when the provider sends no IVR/DTMF digit (hi primary)
DEFAULT_CALLER_LANGUAGE=hi
# Single-clinic MVP: clinic id stamped on inbound calls ("" = unassigned)
DEFAULT_CLINIC_ID=

# Payments (Multi-gateway for India)
# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PhonePe
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# Cashfree
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# Payment links (spec-payments.md G6-Q5): base URL the gateway callbacks / link
# shorteners route through (distinct from FRONTEND_URL — links go to the
# caller's phone via SMS). Empty = link builder still runs, dispatch 501s.
PAYMENT_LINK_BASE_URL=http://localhost:8001

# Notifications (spec-notifications-q8.md G6-Q8): WhatsApp-first messaging layer.
# Empty keys = channel gated: manual POST /api/notifications/send 501s; the
# payment-create hook records status=queued (never fails the payment).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
KNOWLARITY_SMS_TOKEN=
KNOWLARITY_SMS_SENDER_ID=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@medicall.in
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Pharmacovigilance (spec-micc-pv-module.md): PVOIC inbox that receives the
# pv_alert email for every serious case deadline. Empty = no PV alert email is
# sent (the case, its audit row and its deadline are still recorded).
PV_PVOIC_EMAIL=

# ── DPDP Act 2023 (G6-Q2, spec-dpdp-q2.md) ────────────────────────────────
# Retention policy (days): calls 365, recordings 365 (external MinIO objects —
# the object purge is a Docker/CI follow-on), notifications 180, audit 2190
# (6 yr; includes compliance_events). Purge runs from the Docker/CI cron.
RETENTION_CALLS_DAYS=365
RETENTION_RECORDINGS_DAYS=365
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_AUDIT_DAYS=2190
# 72-hr DPDP breach notification window — computed deadline stored on each
# compliance_events row at insert (bad values fall back to 72h).
DPDP_BREACH_NOTIFICATION_HOURS=72
# Data-localization posture: documented region default "in" (G6-Q10, sign-off
# Q3=A2): provider home is Railway asia-southeast1 ("nearest available" —
# Railway has no Mumbai region as of 2026-09-25) with the frontend at Vercel
# bom1 (Mumbai); zero-retention BAAs documented in docs/DEPLOYMENT.md.
# docker-compose.yml pins DATA_RESIDENCY_REGION=in unconditionally.
DATA_RESIDENCY_REGION=in
# Designated Data Protection Officer (surfaced by services/compliance.py).
DPO_NAME=
DPO_EMAIL=

# Auth (Phase-1: password + OTP; SSO gated until the keys below are set)
# Production: a long random value — never reuse the dev default.
AUTH_JWT_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=43200
OTP_TTL_SECONDS=600
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ABHA_OAUTH_CLIENT_ID=
ABHA_OAUTH_CLIENT_SECRET=

# Frontend URL (for CORS and payment links)
FRONTEND_URL=http://localhost:3000

# App
DEBUG=true
LOG_LEVEL=debug
ENVIRONMENT=development