# MediCall AI — Backend Environment Variables
# Copy to .env and fill in your values

# Database (Local PostgreSQL + pgvector)
# Enforcement flip (spec-auth-enforcement.md): the API connects as the NON-owner
# medicall_app role so RLS applies to every statement (postgres_schema.sql
# creates the role + FORCEs RLS; DDL/init stays owner-side). Dev creds only.
DATABASE_URL=postgresql://medicall_app:medicall_app@localhost:5432/medicall

# Voice webhook shared secret (spec-auth-enforcement.md Q2/A2a): provider
# callbacks must send X-Service-Token == this value or they 401. Dev default;
# override in prod. Smoke test reads it as WEBHOOK_SERVICE_TOKEN too.
WEBHOOK_SERVICE_TOKEN=dev-service-token

# Demo tenant bootstrap (schema.sql seed — RLS makes it the ONLY first owner):
#   phone +919876543210 / password DemoPass!2026  (role owner, owns City Care Demo)
# Login via /api/auth/login; smoke_api.py drives the whole domain surface with it.

# Redis (Local)
REDIS_URL=redis://localhost:6379

# Telephony (Multi-provider for India)
# Exotel
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_SID=your-exotel-sid
EXOTEL_TOKEN=your-exotel-token

# Knowlarity (SR API — auth headers: `authorization` + `x-api-key`)
KNOWLARITY_API_KEY=your-knowlarity-api-key
KNOWLARITY_AUTHORIZATION=your-knowlarity-authorization-key
KNOWLARITY_SIP_URI=your-knowlarity-sip-uri

# Twilio India
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-india-number

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Deepgram (Multi-language STT)
DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# ElevenLabs (Multi-language TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_HINDI=your-hindi-voice-id
ELEVENLABS_VOICE_ID_TAMIL=your-tamil-voice-id
ELEVENLABS_VOICE_ID_TELUGU=your-telugu-voice-id
ELEVENLABS_VOICE_ID_BENGALI=your-bengali-voice-id
ELEVENLABS_VOICE_ID_ENGLISH=21m00Tcm4TlvDq8ikWAM

# Call defaults (G4 — D3)
# Default caller language when the provider sends no IVR/DTMF digit (hi primary)
DEFAULT_CALLER_LANGUAGE=hi
# Single-clinic MVP: clinic id stamped on inbound calls ("" = unassigned)
DEFAULT_CLINIC_ID=

# Payments (Multi-gateway for India)
# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PhonePe
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# Cashfree
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# Auth (Phase-1: password + OTP; SSO gated until the keys below are set)
# Production: a long random value — never reuse the dev default.
AUTH_JWT_SECRET=change-me-in-production
AUTH_TOKEN_TTL_SECONDS=43200
OTP_TTL_SECONDS=600
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
ABHA_OAUTH_CLIENT_ID=
ABHA_OAUTH_CLIENT_SECRET=

# Frontend URL (for CORS and payment links)
FRONTEND_URL=http://localhost:3000

# App
DEBUG=true
LOG_LEVEL=debug
ENVIRONMENT=development